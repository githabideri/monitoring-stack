# Minimal grafana.ini — everything else stays at built-in defaults.
[paths]
# Grafana writes into its working dir by default; in the LXC that is the
# (read-only-ish) install dir, so pin all state under grafana_home.
data = {{ grafana_home }}/data
logs = {{ grafana_home }}/logs
plugins = {{ grafana_home }}/plugins
provisioning = {{ grafana_config_dir }}/provisioning

[server]
protocol = http
http_port = {{ grafana_http_port }}
# Bind all interfaces; keep the port on a trusted network and gate access
# with a reverse proxy + Grafana's own authentication.
# Behind a reverse proxy, set grafana_root_url to the EXTERNAL url (the proxy
# domain, no port) — e.g. https://grafana-ui.example.lan/. The
# %(protocol)s/%(domain)s form breaks behind a proxy because it appends the
# internal :{{ grafana_http_port }} and Grafana then redirects logins there.
{% if grafana_root_url is defined and grafana_root_url | length > 0 %}
root_url = {{ grafana_root_url }}
{% else %}
root_url = %(protocol)s://%(domain)s:%(http_port)s/
{% endif %}

[users]
# Admin password comes from grafana.env (GF_SECURITY_ADMIN_PASSWORD),
# set on first boot; subsequent runs reuse the stored (hashed) password.
default_theme = dark
allow_sign_up = false
allow_org_create = false

[analytics]
reporting_enabled = false
# No update pings, no welcome screen: this is an appliance, not a learning
# environment. (The home dashboard itself is set in [dashboards] below —
# Grafana only reads default_home_dashboard_path from that section.)
check_for_updates = false
check_for_plugin_updates = false

[dashboards]
# Home after login = the provisioned fleet overview
# (grafana_default_home_dashboard); this replaces Grafana's default
# "Welcome" page. This is a RENDER path, not a redirect: a user without a
# stored home preference gets this file's contents at GET
# /api/dashboards/home; a per-user home preference (set in the UI) overrides.
# NOTE: 11.6 only parses this key from the [dashboards] section.
default_home_dashboard_path = {{ grafana_home }}/dashboards/{{ grafana_default_home_dashboard }}
