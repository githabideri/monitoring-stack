{
  "annotations": {
    "list": []
  },
  "description": "--homelab-dashboard: backups. Question: are we protected? PBS (Proxmox Backup Server) guest backup state \u2014 how old, verified or not, never-backed-up, datastore capacity \u2014 plus the PVE live-backup job coverage.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/homelab-overview"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 300,
      "panels": [],
      "title": "Backup fleet status",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "pbs-exporter reachability against the Proxmox Backup Server. 0 = no backup data at all \u2014 everything else on this dashboard is stale.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "pbs_up",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "PBS up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Backup datastore capacity (used/size).",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 75
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "homelab:pbs_datastore_used:ratio * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Datastore used (%)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Guests with at least one snapshot on PBS.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short"
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "count(pbs_snapshot_vm_count)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Guests backed up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Oldest guest snapshot across all namespaces. Daily backup => >36h means a missed cycle.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "h",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 24
                },
                {
                  "color": "red",
                  "value": 36
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "max(homelab:backup_age_seconds / 3600)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Oldest backup (h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Guests that have NEVER been backed up (last_timestamp = 0).",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "count(pbs_snapshot_vm_last_timestamp == 0) or vector(0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Never backed up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Guests whose last snapshot was never verified (pbs_snapshot_vm_last_verify = 0). Unverified snapshots are not trusted for restore.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "count(homelab:backup_verified == 0) or vector(0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Not verified",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "PVE guests with no live-backup job at all (pve-exporter). Independent of PBS history.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "count(pve_not_backed_up_info == 1)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "No PVE backup job",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 301,
      "panels": [],
      "title": "Per-guest backup state \u2014 oldest first",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "One row per guest. age = time() - last snapshot timestamp (0 = never). verified: 1 = snapshot verified, 0 = not. Sorted by age \u2014 the rows at the top are the ones to worry about.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "auto"
          }
        ],
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "boolean"
              },
              {
                "id": "custom.displayMode",
                "value": "color-text"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 8,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value #A"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "(time() - pbs_snapshot_vm_last_timestamp) / 3600",
          "instant": true,
          "legendFormat": "age",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "homelab:backup_verified",
          "instant": true,
          "legendFormat": "verified",
          "refId": "B"
        }
      ],
      "title": "Guests (oldest first)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "Value #A": "Age (h)",
              "Value #B": "Verified",
              "namespace": "Host",
              "vm_name": "Guest",
              "vm_id": "VM ID",
              "datastore": "Datastore"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 302,
      "panels": [],
      "title": "Trends",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Backup age per namespace (source host). A line that climbs past 36h for a namespace = that host's backup job is broken.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "h",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 24
                },
                {
                  "color": "red",
                  "value": 36
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "max by (namespace) (homelab:backup_age_seconds / 3600)",
          "instant": false,
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "title": "Oldest backup per namespace (h)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "fieldConfig": {
        "defaults": [
          {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 20,
              "lineWidth": 1
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "homelab:pbs_datastore_used:ratio * 100",
          "instant": false,
          "legendFormat": "{{datastore}}",
          "refId": "A"
        }
      ],
      "title": "Datastore used (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Snapshot counts per source host \u2014 capacity and coverage over time.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 40,
              "lineWidth": 1
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "sum by (namespace) (pbs_snapshot_vm_count)",
          "instant": false,
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "title": "Snapshots per namespace",
      "type": "timeseries"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "homelab"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Backups",
  "uid": "homelab-backups",
  "version": 1
}