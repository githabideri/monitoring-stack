    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Prefix/prompt-cache hit ratio per model (0..100). A falling ratio on a stable workload = changing prompt shapes (or cache pressure).",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
