{
  "annotations": {
    "list": []
  },
  "description": "--homelab-dashboard: prometheus-self. Question: is monitoring itself trustworthy? TSDB footprint against the 16 GiB guard, series growth, scrape health, rule evaluation.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/homelab-overview"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 700,
      "panels": [],
      "title": "Storage & scale",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "TSDB footprint: compacted blocks + in-memory head, against the 16 GiB retention guard in the config.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 8500000000.0
                },
                {
                  "color": "red",
                  "value": 13700000000.0
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "prometheus_tsdb_storage_blocks_bytes + prometheus_tsdb_head_chunks_storage_size_bytes",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "TSDB size (blocks + head)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Active series in the head. Growth trend = label cardinality drift to investigate.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 50000
                }
              ]
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "prometheus_tsdb_head_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Active series (head)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Samples per second accepted into the head.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "cps"
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Samples/s",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 701,
      "panels": [],
      "title": "Scrape & rule health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Targets per scrape job and health. down = the job's targets failing (the job-level view of the overview's target stats).",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "sum by (scrape_job, health) (prometheus_target_scrape_pool_targets)",
          "instant": false,
          "legendFormat": "{{scrape_job}} ({{health}})",
          "refId": "A"
        }
      ],
      "title": "Targets per job (by health)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Scrapes per second per job. Prometheus 3.x no longer keeps scrape-duration quantiles, so this is the liveness check: a job at 0 is not scraping at all.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "ops",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "sum by (job) (rate(prometheus_target_scrape_duration_seconds_count[5m]))",
          "instant": false,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Scrape rate per job (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Rule evaluation: failures (must stay 0) and group duration vs interval.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1
            }
          }
        ],
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "failures.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.001
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "sum by (group) (prometheus_rule_group_last_duration_seconds)",
          "instant": false,
          "legendFormat": "{{group}} (duration)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "sum(rate(prometheus_rule_evaluation_failures_total[5m]))",
          "instant": false,
          "legendFormat": "failures/s",
          "refId": "B"
        }
      ],
      "title": "Rule evaluation (group duration / failures)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 702,
      "panels": [],
      "title": "Growth trends",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "TSDB footprint over the retention window \u2014 the 90d/16GiB budget made visible.",
      "fieldConfig": {
        "defaults": [
          {
            "unit": "bytes",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 20,
              "lineWidth": 1
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "prometheus_tsdb_storage_blocks_bytes",
          "instant": false,
          "legendFormat": "blocks",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "prometheus_tsdb_head_chunks_storage_size_bytes",
          "instant": false,
          "legendFormat": "head",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "prometheus_tsdb_wal_storage_size_bytes",
          "instant": false,
          "legendFormat": "wal",
          "refId": "C"
        }
      ],
      "title": "TSDB footprint (blocks / head / WAL)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "fieldConfig": {
        "defaults": [
          {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 20,
              "lineWidth": 1
            }
          }
        ],
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "prometheus_tsdb_head_series",
          "instant": false,
          "legendFormat": "head series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-homelab"
          },
          "expr": "prometheus_tsdb_blocks_loaded",
          "instant": false,
          "legendFormat": "blocks loaded",
          "refId": "B"
        }
      ],
      "title": "Series & blocks over time",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "homelab"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
