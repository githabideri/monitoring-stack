[Unit]
Description=vLLM engine-liveness probe (vllm_engine_health)
After=network-online.target
Wants=network-online.target

[Service]
User=prometheus
Group=prometheus
ExecStart=/usr/bin/python3 /opt/vllm-health-probe/vllm_health_probe.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
